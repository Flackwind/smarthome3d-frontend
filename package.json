{
  "name": "smart-home-3d",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "start:lan": "ng serve --host 0.0.0.0 --ssl --proxy-config proxy.lan.json",
    "build": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "typecheck": "tsc --noEmit -p tsconfig.check.json && ngc --noEmit -p apps/web/tsconfig.app.json && tsc --noEmit -p apps/web/tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:backend": "SH3D_BACKEND_E2E=1 playwright test"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "pdfjs-dist": "^5.4.624",
    "rxjs": "^7.8.2",
    "three": "^0.183.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "@types/three": "^0.183.0",
    "fake-indexeddb": "^6.2.4",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  }
}
