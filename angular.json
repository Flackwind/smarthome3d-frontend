{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "web": {
      "projectType": "application", "root": "apps/web", "sourceRoot": "apps/web/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/web", "browser": "apps/web/src/main.ts",
            "tsConfig": "apps/web/tsconfig.app.json", "webWorkerTsConfig":"apps/web/tsconfig.worker.json", "index": "apps/web/src/index.html",
            "styles": ["apps/web/src/styles.scss"],
            "assets": [
              { "glob": "**/*", "input": "apps/web/public", "output": "/" },
              { "glob": "pdf.worker.min.mjs", "input": "node_modules/pdfjs-dist/build", "output": "/" },
              { "glob": "**/*", "input": "node_modules/pdfjs-dist/wasm", "output": "/pdf-wasm/" }
            ]
          },
          "configurations": {
            "production": { "outputHashing": "all", "serviceWorker": "apps/web/ngsw-config.json", "budgets": [{ "type": "initial", "maximumWarning": "1mb", "maximumError": "1.5mb" }] },
            "development": { "optimization": false, "sourceMap": true, "extractLicenses": false }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": { "production": { "buildTarget": "web:build:production" }, "development": { "buildTarget": "web:build:development" } },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
